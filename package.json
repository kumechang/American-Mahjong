{
  "name": "american-mahjong-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "wrangler d1 migrations apply DB --remote && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute american-mahjong-db --local --file=$npm_config_file",
    "db:migrate:remote": "wrangler d1 execute american-mahjong-db --remote --file=$npm_config_file",
    "db:seed:local": "wrangler d1 execute american-mahjong-db --local --file=drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute american-mahjong-db --remote --file=drizzle/seed.sql",
    "validate:csv": "node scripts/validate-csv.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  }
}
