// Prisma schema for the American Mahjong discovery platform.
// Models follow the data strategy in the business plan (section 12):
// City / Club / Instructor / Event / Product, with verification metadata
// (source_url, last_verified_at, status) on each scraped/curated entity.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  NEEDS_REVIEW
}

enum LessonType {
  PRIVATE
  GROUP
  ONLINE
}

enum EventType {
  OPEN_PLAY
  TOURNAMENT
  SOCIAL
  LESSON
  OTHER
}

/// A city landing page (e.g. "American Mahjong in Dallas").
/// This is the core SEO/programmatic-SEO unit described in section 10-11.
model City {
  id        String   @id @default(cuid())
  name      String
  state     String
  slug      String   @unique
  latitude  Float?
  longitude Float?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs       Club[]
  instructors Instructor[]
  events      Event[]

  @@unique([name, state])
}

model Club {
  id   String @id @default(cuid())
  name String
  slug String @unique

  description String?

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  address String?
  website String?
  phone   String?
  email   String?

  latitude  Float?
  longitude Float?

  beginnerFriendly Boolean  @default(false)
  lessonsAvailable Boolean  @default(false)
  openPlay         Boolean  @default(false)
  socialPlay       Boolean  @default(false)
  womenOnly        Boolean  @default(false)
  free             Boolean  @default(false)
  price            Decimal? @db.Decimal(10, 2)
  schedule         String?

  sourceUrl      String?
  lastVerifiedAt DateTime?
  status         RecordStatus @default(NEEDS_REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([cityId])
  @@index([beginnerFriendly])
}

model Instructor {
  id   String @id @default(cuid())
  name String
  slug String @unique

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  website String?
  contact String?

  lessonType     LessonType[]
  privateLesson  Boolean      @default(false)
  groupLesson    Boolean      @default(false)
  onlineLesson   Boolean      @default(false)
  beginnerLesson Boolean      @default(false)
  price          Decimal?     @db.Decimal(10, 2)

  sourceUrl      String?
  lastVerifiedAt DateTime?
  status         RecordStatus @default(NEEDS_REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([cityId])
}

model Event {
  id   String @id @default(cuid())
  name String
  slug String @unique

  eventDate DateTime
  startTime String?
  endTime   String?

  venue String?

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  clubId       String?
  club         Club?       @relation(fields: [clubId], references: [id])
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])

  eventType        EventType @default(OTHER)
  beginnerFriendly Boolean   @default(false)
  price            Decimal?  @db.Decimal(10, 2)
  registrationUrl  String?

  sourceUrl      String?
  lastVerifiedAt DateTime?
  status         RecordStatus @default(NEEDS_REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([eventDate])
}

/// Shop / Affiliate content (section 4, 17-Phase2): mahjong sets, tiles,
/// racks, etc. Curated product recommendations, not a storefront.
model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  category     String
  description  String?
  imageUrl     String?
  affiliateUrl String
  price        Decimal? @db.Decimal(10, 2)
  beginnerPick Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
